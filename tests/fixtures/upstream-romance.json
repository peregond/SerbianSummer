    {
      "path": [
        "decision_weigh_people",
        "pages"
      ],
      "beforeExists": true,
      "before": [
        {
          "speaker": "narrator",
          "text": "Я пролистываю контакты. Кофе, двор, чужие шутки и общие стулья складываются в жизнь, куда меня пригласили, а не втащили."
        },
        {
          "speaker": "narrator",
          "text": "Но людям можно быть дорогими и на расстоянии. Это тоже нужно взвесить честно."
        },
        {
          "speaker": "Ася",
          "character": "asya",
          "emotion": "friendly",
          "text": "Что бы ты ни выбрал{a}, у двора будет стул для тебя.",
          "message": true
        },
        {
          "speaker": "Лука",
          "character": "luka",
          "emotion": "friendly",
          "text": "Если захочешь пересчитать цифры, я рядом.",
          "message": true,
          "action": {
            "kind": "tap",
            "label": "Отложить телефон и подумать о вечере",
            "object": "Отложить телефон и подумать о вечере"
          }
        }
      ],
      "afterHash": "f699ea698aaa63b551f7741a2be51511387cdb8203709558341b160f99d65a95"
