  "changes": [
    {
      "path": [
        "decision_weigh_work",
        "pages"
      ],
      "beforeExists": true,
      "before": [
        {
          "speaker": "narrator",
          "text": "Я открываю заметки о проекте. Там уже не абстрактные планы, а список ближайших шагов и пара имён, которым можно написать."
        },
        {
          "speaker": "narrator",
          "text": "Дело не требует, чтобы я остался любой ценой. Оно просто показывает: здесь у меня получается строить."
        },
        {
          "speaker": "Ася",
          "character": "asya",
          "emotion": "friendly",
          "text": "Что бы ты ни выбрал{a}, у двора будет стул для тебя.",
          "message": true
        },
        {
          "speaker": "Лука",
          "character": "luka",
          "emotion": "friendly",
          "text": "Если захочешь пересчитать цифры, я рядом.",
          "message": true,
          "action": {
            "kind": "tap",
            "label": "Отложить заметки и подумать о вечере",
            "object": "Отложить заметки и подумать о вечере"
          }
